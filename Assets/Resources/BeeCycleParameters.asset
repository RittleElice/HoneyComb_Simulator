%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 37230c866841a6342b5dd102d3ded4b3, type: 3}
  m_Name: BeeCycleParameters
  m_EditorClassIdentifier: Assembly-CSharp::BeeCycleSettingsAsset
  values:
    directionRoutingEnabled: 1
    apiaryMovementEnabled: 1
    apiaryArrivalStopPercent: 50
    apiaryCellMeters: 1
    apiaryFlightMetersPerSecond: 1
    apiaryWaitPercent: 5
    apiaryFollowDirectionPercent: 80
    apiaryOtherDirectionPercent: 15
    apiaryReturnRadius: 1
    apiaryReturnDistanceExponent: 1
    forageShortageReturnRate: 0.2
    forageLoadBased: 1
    forageSugarRate: 1.875
    foragePollenRate: 1.875
    forageReturnExponent: 2
    forageDepartureExponent: 2
    formulas:
    - name: workDesireRelief
      expression: actionRate*ratio
    - name: demandNext
      expression: clamp(amount+available-need,0,100)
    - name: demandProbability
      expression: clamp(amount/100,0,1)
    - name: demandDesireNext
      expression: max(0,amount-demandDesireDecay)
    - name: demandPulse
      expression: demandCommandPulse
    - name: demandDays
      expression: amount/max(available,0.000000001)
    - name: demandRatio
      expression: clamp(amount/max(available,0.000000001),0,1)
    - name: demandFoodSignal
      expression: demandFoodShortageGain*amount+demandFoodOpportunityGain*available*ratio*need
    - name: demandForageIncrease
      expression: max(amount,available)+demandFailureGain*need
    - name: demandBuildIncrease
      expression: demandBuildGain*amount+demandFailureGain*need
    - name: demandClearIncrease
      expression: demandClearGain*amount*ratio+demandFailureGain*need
    - name: demandLayIncrease
      expression: (demandLayWorkerGain*amount+demandLayBroodGain*available)*ratio*need
    - name: demandWorkerTarget
      expression: max(demandWorkerMinimum,demandWorkersPerCell*amount)
    - name: demandBroodTarget
      expression: min(broodTarget,min(demandBroodPerWorker*amount,demandBroodPerCell*available))
    - name: demandEmptyTarget
      expression: max(demandEmptyMinimum,demandEmptyPerWorker*amount)+max(0,available-need)
    - name: demandGrowthSugar
      expression: clamp((amount-demandGrowthSugarFloor)/demandGrowthSugarRange,0,1)
    - name: demandGrowthPollen
      expression: clamp((amount-demandGrowthPollenFloor)/demandGrowthPollenRange,0,1)
    - name: demandNurseIncrease
      expression: demandRegionNurseGain*ratio
    - name: demandHeatIncrease
      expression: demandRegionHeatGain*ratio
    - name: demandBuildCandidate
      expression: amount/max(available,demandCandidateWorkFloor)/(1+need/demandCandidateLoadScale)
    - name: demandClearCandidate
      expression: amount/max(available,demandCandidateFoodFloor)/(1+need/demandCandidateLoadScale)
    - name: demandLayCandidate
      expression: amount*ratio
    - name: demandDailySugar
      expression: amount*demandDailyAdultSugar+available*demandDailyBroodSugar
    - name: demandDailyPollen
      expression: amount*demandDailyAdultPollen+available*demandDailyBroodPollen
    - name: demandSupplyTarget
      expression: amount*available*demandSupplyMinutes*demandForecastForagerFraction
    - name: demandReservedCells
      expression: amount*ratio
    - name: forageCollectSugar
      expression: forageSugarRate*time
    - name: forageCollectPollen
      expression: foragePollenRate*time
    - name: forageShortageReturnChance
      expression: clamp(ratio,0,1)*forageShortageReturnRate
    - name: forageReturnChance
      expression: pow(clamp(ratio,0,1),forageReturnExponent)
    - name: forageDepartureWeight
      expression: pow(clamp(1-ratio,0,1),forageDepartureExponent)
    - name: relocateTemperatureDesire
      expression: relocateTemperatureWeight*clamp(ratio,0,1)
    - name: relocateCrowdingDesire
      expression: relocateCrowdingWeight*clamp(ratio,0,1)
    - name: relocateDestination
      expression: amount/(1+distance/relocateDistanceMm)
    - name: deficit
      expression: clamp(1-amount/max(available,0.000000001),0,1)
    - name: commandChance
      expression: 1
    - name: feedDesire
      expression: feedWeight * pow(clamp(ratio,0,1),2)
    - name: restDesire
      expression: restWeight * pow(clamp(ratio,0,1),2)
    - name: recoverDesire
      expression: recoverWeight * pow(clamp(ratio,0,1),2)
    - name: storeDesire
      expression: storeWeight * pow(clamp(ratio,0,1),2)
    - name: buildCellWeight
      expression: 1+amount
    - name: layCellWeight
      expression: band(ratio,0.5,2,1/(1+distance),1+amount,1+amount)
    - name: larvaDevelopmentFactor
      expression: ratio*min(available,amount)
    - name: nurseNeed
      expression: clamp(amount/max(available,0.000000001),0,1)
    - name: heatNeed
      expression: clamp(amount/heatDeficitScale,0,1)
    - name: commandStimulus
      expression: commandMaximum * clamp(need,0,1)
    - name: desireNext
      expression: max(0,amount+available-naturalDecay)
    - name: interruptChance
      expression: clamp(elapsed*interruptPerElapsedMinute,0,1)
    - name: storagePreference
      expression: available*(1+storageHeightBias*height)/(1+distance/storageDistanceMm)
    - name: buildPreference
      expression: 0.6+0.4*clamp(1-amount/20,0,1)
    - name: development
      expression: actionRate*time
    - name: broodTemperature
      expression: clamp(min((temperature-broodMinTemperature)/(broodIdealTemperature-broodMinTemperature),(broodMaxTemperature-temperature)/(broodMaxTemperature-broodIdealTemperature)),0,1)
    - name: broodDevelopment
      expression: broodTick*ratio*time
    - name: basalHeat
      expression: basalHeatJ*time
    - name: broodBasalHeat
      expression: amount*time
    - name: additionalHeat
      expression: extraHeatJ*time
    - name: basalSugarCost
      expression: basalSugar*time
    - name: basalEnergyCost
      expression: basalEnergy*time
    - name: movementEnergyCost
      expression: movementEnergy*time
    - name: moveDistance
      expression: speed*60*time
    - name: feedAmount
      expression: min(feedRate*time,amount)
    - name: restAmount
      expression: min(restRate*time,amount)
    - name: recoverAmount
      expression: min(recoveryRate*time,amount)
    - name: acquireAmount
      expression: min(acquireRate*time,amount)
    - name: storeAmount
      expression: min(storeRate*time,amount)
    - name: buildAmount
      expression: buildPoints*time
    - name: forageDuration
      expression: forageMinutes
    - name: forageSugarAmount
      expression: forageSugar
    - name: foragePollenAmount
      expression: foragePollen
    - name: forageWaterAmount
      expression: forageWater
    - name: nurseAmount
      expression: nurseRate*time
    - name: starvation
      expression: starvationDamage*time
    - name: layChance
      expression: clamp(queenLayPerMinute*time,0,1)
